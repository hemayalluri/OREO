# Copy this file to .env and fill in your values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Only for user-level keys (sk-ant-usr-...): the workspace ID from the Console.
ANTHROPIC_WORKSPACE_ID=

# Step 3: only needed when email.mode is "smtp" in config.yaml (the default "outbox" mode sends nothing).
# Use an app password from your mail provider, never your main password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
